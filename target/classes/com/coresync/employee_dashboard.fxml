<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coresync.controllers.EmployeeController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" prefHeight="76.0" BorderPane.alignment="CENTER">
            <padding><Insets left="30.0" right="30.0" /></padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="⚡" textFill="#2563EB"><font><Font size="24.0"/></font></Label>
                <Label text="CoreSync" textFill="#0F172A"><font><Font name="System Bold" size="22.0" /></font></Label>
                <Label text="Employee" textFill="#64748B"><font><Font size="22.0" /></font></Label>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="24">
                <TextField fx:id="searchBar" onKeyReleased="#handleSearch" promptText="Search holidays..." styleClass="modern-input" prefWidth="280.0"/>
                <MenuButton style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <HBox alignment="CENTER" spacing="12">
                            <StackPane>
                                <Circle radius="20.0" fill="#E0E7FF" />
                                <Label text="EMP" textFill="#4338CA" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                            </StackPane>
                            <VBox alignment="CENTER_LEFT">
                                <Label fx:id="userNameLabel" text="Employee" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                                <Label text="Standard User" style="-fx-text-fill: #64748B; -fx-font-size: 12;" />
                            </VBox>
                        </HBox>
                    </graphic>
                    <items><MenuItem onAction="#handleLogout" text="Logout" /></items>
                </MenuButton>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar" prefWidth="260.0" BorderPane.alignment="CENTER">
            <padding><Insets top="24.0" bottom="24.0" /></padding>
            
            <Label text="MAIN MENU" style="-fx-text-fill: #94A3B8; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 0 0 10 24;" />
            <HBox fx:id="dashboardBtn" styleClass="sidebar-btn" alignment="CENTER_LEFT" spacing="16.0" onMouseClicked="#showDashboard">
                <Label styleClass="sidebar-icon" text="🏠" textFill="#64748B"><font><Font size="20.0" /></font></Label>
                <Label styleClass="sidebar-text" text="My Dashboard" textFill="#475569"><font><Font size="15.0" /></font></Label>
            </HBox>
            <HBox fx:id="attendanceBtn" styleClass="sidebar-btn" alignment="CENTER_LEFT" spacing="16.0" onMouseClicked="#showAttendance">
                <Label styleClass="sidebar-icon" text="⏱️" textFill="#64748B"><font><Font size="20.0" /></font></Label>
                <Label styleClass="sidebar-text" text="My Attendance" textFill="#475569"><font><Font size="15.0" /></font></Label>
            </HBox>
            
            <Label text="FINANCE AND LEAVE" style="-fx-text-fill: #94A3B8; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 24 0 10 24;" />
            <HBox fx:id="leaveBtn" styleClass="sidebar-btn" alignment="CENTER_LEFT" spacing="16.0" onMouseClicked="#showLeaveRequest">
                <Label styleClass="sidebar-icon" text="🏖️" textFill="#64748B"><font><Font size="20.0" /></font></Label>
                <Label styleClass="sidebar-text" text="Leave Request" textFill="#475569"><font><Font size="15.0" /></font></Label>
            </HBox>
            <HBox fx:id="holidaysBtn" styleClass="sidebar-btn" alignment="CENTER_LEFT" spacing="16.0" onMouseClicked="#showHolidays">
                <Label styleClass="sidebar-icon" text="🎉" textFill="#64748B"><font><Font size="20.0" /></font></Label>
                <Label styleClass="sidebar-text" text="Holidays" textFill="#475569"><font><Font size="15.0" /></font></Label>
            </HBox>
            
            <Label text="ACCOUNT" style="-fx-text-fill: #94A3B8; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 24 0 10 24;" />
            <HBox fx:id="settingsBtn" styleClass="sidebar-btn" alignment="CENTER_LEFT" spacing="16.0" onMouseClicked="#showSettings">
                <Label styleClass="sidebar-icon" text="⚙️" textFill="#64748B"><font><Font size="20.0" /></font></Label>
                <Label styleClass="sidebar-text" text="Settings" textFill="#475569"><font><Font size="15.0" /></font></Label>
            </HBox>

            <Region VBox.vgrow="ALWAYS" />
            <HBox styleClass="sidebar-btn" alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 15 24; -fx-cursor: hand;" onMouseClicked="#handleLogoutAsMouseEvent">
                <Label styleClass="sidebar-icon" text="🚪" style="-fx-text-fill: #EF4444;"><font><Font size="20.0" /></font></Label>
                <Label styleClass="sidebar-text" text="Logout" style="-fx-text-fill: #EF4444; -fx-font-weight: bold;"><font><Font size="15.0" /></font></Label>
            </HBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <StackPane fx:id="mainContentArea" style="-fx-background-color: #F8FAFC;">
                <padding><Insets top="32.0" right="32.0" bottom="32.0" left="32.0" /></padding>
                
                <VBox fx:id="dashboardVBox" spacing="24.0" maxWidth="900.0" alignment="TOP_LEFT">
                    <VBox spacing="6.0">
                        <Label fx:id="welcomeLabel" text="Welcome back, Employee!" styleClass="title-1" />
                        <Label text="Here is your current status and leave balance." styleClass="subtitle" />
                    </VBox>
                    <Label text="My Leave Balance" styleClass="card-title" style="-fx-padding: 8 0 0 0;" />
                    <FlowPane hgap="24.0" vgap="24.0">
                        <HBox fx:id="cardTotal" styleClass="card" spacing="20.0" prefWidth="280.0" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: #DBEAFE; -fx-background-radius: 12; -fx-padding: 16;"><Label text="📋" textFill="#2563EB"><font><Font size="24.0" /></font></Label></StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="4.0"><Label text="Total Allowed" styleClass="card-title" /><Label fx:id="totalLeavesLabel" text="-" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1E293B;" /></VBox>
                        </HBox>
                        <HBox fx:id="cardTaken" styleClass="card" spacing="20.0" prefWidth="280.0" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: #FEE2E2; -fx-background-radius: 12; -fx-padding: 16;"><Label text="✈️" textFill="#DC2626"><font><Font size="24.0" /></font></Label></StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="4.0"><Label text="Leaves Taken" styleClass="card-title" /><Label fx:id="takenLeavesLabel" text="-" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1E293B;" /></VBox>
                        </HBox>
                        <HBox fx:id="cardRemaining" styleClass="card" spacing="20.0" prefWidth="280.0" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: #DCFCE7; -fx-background-radius: 12; -fx-padding: 16;"><Label text="✅" textFill="#16A34A"><font><Font size="24.0" /></font></Label></StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="4.0"><Label text="Remaining Balance" styleClass="card-title" /><Label fx:id="remainingLeavesLabel" text="-" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1E293B;" /></VBox>
                        </HBox>
                    </FlowPane>
                </VBox>

                <VBox fx:id="attendanceVBox" spacing="24.0" maxWidth="900.0" alignment="TOP_LEFT" visible="false">
                    <Label text="Daily Attendance" styleClass="title-2" />
                    <HBox spacing="24.0">
                        <VBox styleClass="card" spacing="24.0" prefWidth="350.0" alignment="CENTER" style="-fx-padding: 30;">
                            <Label text="Current Status" styleClass="card-title" />
                            <Label fx:id="attendanceStatusLabel" text="🔴 Off Duty" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #64748B;" />
                            <Button fx:id="clockInOutBtn" text="Clock In" onAction="#handleClockToggle" prefWidth="200.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 16; -fx-padding: 10; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                        </VBox>
                        <VBox styleClass="card" spacing="20.0" prefWidth="350.0" alignment="CENTER_LEFT" style="-fx-padding: 30;">
                            <Label text="Today's Record" styleClass="card-title" />
                            <HBox alignment="CENTER_LEFT"><Label text="Time In:" style="-fx-font-weight: bold;"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="timeInLabel" text="--:-- --" style="-fx-font-weight: bold;"/></HBox>
                            <Separator />
                            <HBox alignment="CENTER_LEFT"><Label text="Time Out:" style="-fx-font-weight: bold;"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="timeOutLabel" text="--:-- --" style="-fx-font-weight: bold;"/></HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox fx:id="leaveRequestVBox" spacing="24.0" maxWidth="900.0" alignment="TOP_LEFT" visible="false">
                    <Label text="Leave Management" styleClass="title-2" />
                    
                    <VBox styleClass="card" spacing="20.0" prefWidth="900.0" style="-fx-padding: 20;">
                        <Label text="Submit New Request" styleClass="card-title" />
                        <GridPane hgap="20.0" vgap="15.0">
                            <columnConstraints><ColumnConstraints percentWidth="50.0" /><ColumnConstraints percentWidth="50.0" /></columnConstraints>
                            <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Start Date" style="-fx-font-weight: bold;" />
                                <DatePicker fx:id="startDatePicker" prefWidth="300.0" styleClass="modern-input" />
                            </VBox>
                            <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="End Date" style="-fx-font-weight: bold;" />
                                <DatePicker fx:id="endDatePicker" prefWidth="300.0" styleClass="modern-input" />
                            </VBox>
                            <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                <Label text="Reason for Leave" style="-fx-font-weight: bold;" />
                                <TextArea fx:id="leaveReasonArea" prefRowCount="2" wrapText="true" styleClass="modern-input" />
                            </VBox>
                        </GridPane>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Button text="Submit Request" onAction="#handleSubmitLeaveRequest" styleClass="primary-btn" prefWidth="200.0" />
                            <Label fx:id="leaveStatusLabel" text="" />
                        </HBox>
                    </VBox>
                    
                    <VBox styleClass="card" spacing="10.0" prefWidth="900.0" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">
                        <Label text="My Leave History" styleClass="card-title" />
                        <TableView fx:id="leaveHistoryTable" prefHeight="200.0">
                            <columns>
                                <TableColumn fx:id="historyStartCol" text="Start Date" prefWidth="120.0" />
                                <TableColumn fx:id="historyEndCol" text="End Date" prefWidth="120.0" />
                                <TableColumn fx:id="historyReasonCol" text="Reason" prefWidth="400.0" />
                                <TableColumn fx:id="historyStatusCol" text="Status" prefWidth="150.0" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>

                <VBox fx:id="holidaysVBox" spacing="24.0" maxWidth="900.0" alignment="TOP_LEFT" visible="false">
                    <Label text="Company Holidays" styleClass="title-2" />
                    <VBox styleClass="card" spacing="20.0" VBox.vgrow="ALWAYS" style="-fx-padding: 20;">
                        <TableView fx:id="holidaysTable" prefHeight="400.0">
                            <columns>
                                <TableColumn fx:id="holidayNameCol" text="Holiday Name" prefWidth="300.0" />
                                <TableColumn fx:id="holidayDateCol" text="Date" prefWidth="200.0" />
                                <TableColumn fx:id="holidayTypeCol" text="Type" prefWidth="250.0" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>

                <VBox fx:id="settingsVBox" spacing="20.0" maxWidth="600.0" alignment="TOP_LEFT" visible="false">
                    <Label text="Account Settings" styleClass="title-2" />
                    <VBox styleClass="card" spacing="20.0" style="-fx-padding: 30;">
                        <Label text="Change Password" styleClass="card-title" />
                        <VBox spacing="8.0">
                            <Label text="Current Password" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
                            <PasswordField fx:id="oldPassField" styleClass="modern-input" />
                        </VBox>
                        <VBox spacing="8.0">
                            <Label text="New Password" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
                            <PasswordField fx:id="newPassField" styleClass="modern-input" />
                        </VBox>
                        <Button text="Update Password" onAction="#handleChangePassword" styleClass="primary-btn" prefWidth="200.0" />
                        <Label fx:id="passStatusLabel" />
                    </VBox>
                </VBox>

            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>