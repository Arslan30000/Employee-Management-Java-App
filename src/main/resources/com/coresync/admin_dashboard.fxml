<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coresync.controllers.AdminController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: linear-gradient(to right, #034078, #1282a2);" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <Label text="CoreSync Admin Portal" textFill="WHITE">
                <font><Font name="System Bold" size="22.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <TextField promptText="Search employees..." style="-fx-background-radius: 15; -fx-padding: 5 15; -fx-pref-width: 200; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 15; -fx-background-color: #034078; -fx-text-fill: white;">
                 <HBox.margin>
                    <Insets right="20.0" />
                 </HBox.margin>
            </TextField>
            <HBox alignment="CENTER" spacing="10">
                <Label style="-fx-background-color: #f77f00; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold; -fx-min-width: 30; -fx-min-height: 30; -fx-alignment: center;" text="AM" />
                <MenuButton style="-fx-background-color: transparent; -fx-text-fill: white;" textFill="WHITE">
                    <items>
                        <MenuItem onAction="#handleLogout" text="Logout" />
                    </items>
                </MenuButton>
            </HBox>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="mainContentArea" style="-fx-background-color: #F8F9FA;">
            
            <!-- Dashboard VBox wrapper for spacing above the grid -->
            <VBox fx:id="dashboardVBox" alignment="TOP_CENTER" spacing="20.0">
                <padding>
                    <Insets top="30.0" left="30.0" right="30.0" bottom="30.0"/>
                </padding>
                
                <Label text="Quick Actions" textFill="#555555" style="-fx-font-weight: bold;">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <!-- Dashboard Grid -->
                <GridPane fx:id="dashboardGrid" alignment="CENTER" hgap="30.0" vgap="30.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="CENTER" minWidth="250.0" />
                        <ColumnConstraints halignment="CENTER" minWidth="250.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="160.0" valignment="CENTER" />
                        <RowConstraints minHeight="160.0" valignment="CENTER" />
                    </rowConstraints>

                    <!-- Add Employee Card -->
                    <VBox fx:id="addEmployeeCard" alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 15, 0, 0, 5); -fx-cursor: hand; -fx-border-color: #f77f00 transparent transparent transparent; -fx-border-width: 4 0 0 0;" GridPane.columnIndex="0" GridPane.rowIndex="0" onMouseClicked="#showAddEmployeeForm">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <Label text="➕👤" textFill="#f77f00">
                            <font><Font size="32.0" /></font>
                        </Label>
                        <Label text="Add Employee" textFill="#034078">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                    </VBox>

                    <!-- Manage Employees Card -->
                    <VBox fx:id="manageEmployeesCard" alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 15, 0, 0, 5); -fx-cursor: hand; -fx-border-color: #f77f00 transparent transparent transparent; -fx-border-width: 4 0 0 0;" GridPane.columnIndex="1" GridPane.rowIndex="0" onMouseClicked="#showFeatureNotImplemented">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <Label text="👥" textFill="#f77f00">
                            <font><Font size="32.0" /></font>
                        </Label>
                        <Label text="Manage Employees" textFill="#034078">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                    </VBox>

                    <!-- Leave Management Card -->
                    <VBox fx:id="leaveManagementCard" alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 15, 0, 0, 5); -fx-cursor: hand; -fx-border-color: #f77f00 transparent transparent transparent; -fx-border-width: 4 0 0 0;" GridPane.columnIndex="0" GridPane.rowIndex="1" onMouseClicked="#showFeatureNotImplemented">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <Label text="📅" textFill="#f77f00">
                            <font><Font size="32.0" /></font>
                        </Label>
                        <Label text="Leave Management" textFill="#034078">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                    </VBox>

                    <!-- Payroll Management Card -->
                    <VBox fx:id="payrollManagementCard" alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 15, 0, 0, 5); -fx-cursor: hand; -fx-border-color: #f77f00 transparent transparent transparent; -fx-border-width: 4 0 0 0;" GridPane.columnIndex="1" GridPane.rowIndex="1" onMouseClicked="#showFeatureNotImplemented">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <Label text="💰" textFill="#f77f00">
                            <font><Font size="32.0" /></font>
                        </Label>
                        <Label text="Payroll Management" textFill="#034078">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- Register New Employee Form (Initially Hidden) -->
            <VBox fx:id="addEmployeeForm" alignment="CENTER" maxWidth="500.0" maxHeight="450.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 15, 0, 0, 5);" visible="false">
                <HBox alignment="CENTER_LEFT">
                    <Button onAction="#showDashboard" text="&lt; Back" style="-fx-background-color: transparent; -fx-text-fill: #1282a2; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 5 0;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Register New Employee" textFill="#034078">
                        <font><Font name="System Bold" size="20.0" /></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <!-- Dummy space to balance the back button -->
                    <Region prefWidth="50" />
                </HBox>

                <GridPane hgap="15.0" vgap="15.0" alignment="CENTER">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="120.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" />
                    </columnConstraints>

                    <Label text="Employee ID:" textFill="#034078" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <font><Font name="System Bold" size="14.0" /></font>
                    </Label>
                    <TextField fx:id="empIdField" style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Full Name:" textFill="#034078" GridPane.columnIndex="0" GridPane.rowIndex="1">
                         <font><Font name="System Bold" size="14.0" /></font>
                    </Label>
                    <TextField fx:id="nameField" style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Role:" textFill="#034078" GridPane.columnIndex="0" GridPane.rowIndex="2">
                         <font><Font name="System Bold" size="14.0" /></font>
                    </Label>
                    <ComboBox fx:id="roleComboBox" prefWidth="300.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 3;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Base Salary (PKR):" textFill="#034078" GridPane.columnIndex="0" GridPane.rowIndex="3">
                         <font><Font name="System Bold" size="14.0" /></font>
                    </Label>
                    <TextField fx:id="salaryField" style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label text="Default Password:" textFill="#034078" GridPane.columnIndex="0" GridPane.rowIndex="4">
                         <font><Font name="System Bold" size="14.0" /></font>
                    </Label>
                    <PasswordField fx:id="passField" style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                </GridPane>

                <Button onAction="#handleRegisterEmployee" prefHeight="40.0" prefWidth="400.0" style="-fx-background-color: linear-gradient(to right, #0099cc, #034078); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Register Employee">
                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                </Button>

                <Label fx:id="statusLabel" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>